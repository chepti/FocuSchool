rules_version = '2';

// קריאה ציבורית לתוכן מפורסם. כתיבה — רק לחברים לפי תפקיד:
//   admin / publisher — פרסום ישיר, אישור ומחיקה
//   contributor — שליחת פריטים לאישור בלבד
// ניהול רשימת החברים עצמה נעשה כרגע רק דרך seed/קונסולה (אין כתיבה מהאתר).
service cloud.firestore {
  match /databases/{database}/documents {

    function memberRole(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.token.email.lower())).data.role;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isStaff(schoolId) {
      return isSignedIn() && memberRole(schoolId) in ['admin', 'publisher'];
    }

    function isMember(schoolId) {
      return isSignedIn() && memberRole(schoolId) in ['admin', 'publisher', 'contributor'];
    }

    // כל חבר קהילה מזוהה, כולל הורים — למידע מוגן (מערכת שעות, אלפון, אלבומים)
    function isCommunity(schoolId) {
      return isSignedIn()
             && memberRole(schoolId) in ['admin', 'publisher', 'contributor', 'parent'];
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if false;

      match /members/{email} {
        // כל חבר רואה את הרשומה של עצמו; אדמין רואה ומנהל את כולם
        allow read: if isSignedIn()
                    && (request.auth.token.email.lower() == email
                        || memberRole(schoolId) == 'admin');
        allow write: if isSignedIn() && memberRole(schoolId) == 'admin';

        // טוקני נוטיפיקציות — כל חבר מנהל רק את של עצמו.
        // השליחה נעשית בשרת עם service account (עוקף rules).
        match /tokens/{tokenId} {
          allow read, write: if isSignedIn()
                             && request.auth.token.email.lower() == email;
        }
      }

      match /strips/{stripId} {
        allow read: if true;
        allow write: if false;

        match /items/{itemId} {
          // פריטים בהמתנה גלויים רק לצוות
          allow read: if resource.data.status == 'published' || isStaff(schoolId);
          allow create: if (isStaff(schoolId)
                            && request.resource.data.status in ['published', 'pending'])
                        || (isMember(schoolId)
                            && request.resource.data.status == 'pending');
          allow update, delete: if isStaff(schoolId);

          // מידע להורים בלבד על פריט (למשל קישור לאלבום Google Photos)
          match /private/{docId} {
            allow read: if isCommunity(schoolId);
            allow write: if isStaff(schoolId);
          }
        }
      }

      // מערכת שעות של כיתה — לחברי הקהילה בלבד (הסינון לכיתות של ההורה נעשה ב-UI)
      match /schedules/{classId} {
        allow read: if isCommunity(schoolId);
        allow write: if isSignedIn() && memberRole(schoolId) == 'admin';
      }

      // אלפון צוות — כולל טלפונים, לכן לעולם לא ציבורי
      match /staff/{staffId} {
        allow read: if isCommunity(schoolId);
        allow write: if isSignedIn() && memberRole(schoolId) == 'admin';
      }

      // הערה: כשנוסיף מידע-צוות לאירועים, הוא יישב במסמך משנה נפרד
      // כי אין אבטחה ברמת שדה — לא להוסיף staffInfo למסמך הזה.
      match /events/{eventId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
