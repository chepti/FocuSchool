rules_version = '2';

// קריאה ציבורית לתוכן מפורסם. כתיבה — רק לחברים לפי תפקיד:
//   admin / publisher — פרסום ישיר, אישור ומחיקה
//   contributor — שליחת פריטים לאישור בלבד
// ניהול רשימת החברים עצמה נעשה כרגע רק דרך seed/קונסולה (אין כתיבה מהאתר).
service cloud.firestore {
  match /databases/{database}/documents {

    function memberRole(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.token.email.lower())).data.role;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isStaff(schoolId) {
      return isSignedIn() && memberRole(schoolId) in ['admin', 'publisher'];
    }

    function isMember(schoolId) {
      return isSignedIn() && memberRole(schoolId) in ['admin', 'publisher', 'contributor'];
    }

    // כל חבר קהילה מזוהה, כולל הורים — למידע מוגן (מערכת שעות, אלפון, אלבומים)
    function isCommunity(schoolId) {
      return isSignedIn()
             && memberRole(schoolId) in ['admin', 'publisher', 'contributor', 'parent'];
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if false;

      match /members/{email} {
        // כל חבר רואה את הרשומה של עצמו; צוות (גם מורים — לבחירת יעדי
        // הודעות ואלפון הורים) רואה את כולם; ניהול — אדמין בלבד
        allow read: if isSignedIn()
                    && (request.auth.token.email.lower() == email
                        || isStaff(schoolId));
        allow write: if isSignedIn() && memberRole(schoolId) == 'admin';
        // כל חבר רשאי לעדכן לעצמו את העדפת ההתראות בלבד
        allow update: if isSignedIn()
                      && request.auth.token.email.lower() == email
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['digest']);

        // טוקני נוטיפיקציות — כל חבר מנהל רק את של עצמו.
        // השליחה נעשית בשרת עם service account (עוקף rules).
        match /tokens/{tokenId} {
          allow read, write: if isSignedIn()
                             && request.auth.token.email.lower() == email;
        }
      }

      match /strips/{stripId} {
        allow read: if true;
        allow write: if false;

        match /items/{itemId} {
          // פריטים בהמתנה גלויים רק לצוות
          allow read: if resource.data.status == 'published' || isStaff(schoolId);
          allow create: if (isStaff(schoolId)
                            && request.resource.data.status in ['published', 'pending'])
                        || (isMember(schoolId)
                            && request.resource.data.status == 'pending');
          allow update, delete: if isStaff(schoolId);

          // מידע להורים בלבד על פריט (למשל קישור לאלבום Google Photos)
          match /private/{docId} {
            allow read: if isCommunity(schoolId);
            allow write: if isStaff(schoolId);
          }
        }
      }

      // מערכת שעות של כיתה — לחברי הקהילה בלבד (הסינון לכיתות של ההורה נעשה ב-UI)
      match /schedules/{classId} {
        allow read: if isCommunity(schoolId);
        allow write: if isSignedIn() && memberRole(schoolId) == 'admin';
      }

      // אלפון צוות — כולל טלפונים, לכן לעולם לא ציבורי
      match /staff/{staffId} {
        allow read: if isCommunity(schoolId);
        allow write: if isSignedIn() && memberRole(schoolId) == 'admin';
      }

      // הודעות צוות (עדכון שבועי / תזכורת / ממוקדת) — כתיבה לצוות בלבד.
      // קריאה לכל חבר קהילה; הסינון "רק להורים המסומנים" נעשה כרגע ב-UI
      // וב-push (בשרת) — הקשחה למסמכי-משנה פר-הורה אם יידרש בעתיד.
      match /messages/{messageId} {
        allow read: if isCommunity(schoolId);
        allow create, update, delete: if isStaff(schoolId);
      }

      // צ'קליסטים במעקב (מודול 3.2) — המורה יוצר; הסימונים ב-marks
      match /checklists/{checklistId} {
        allow read: if isCommunity(schoolId);
        allow create, update, delete: if isStaff(schoolId);

        // סימון כפול: ההורה (בעל המסמך) נוגע רק ב-homeChecked;
        // הצוות מסמן classChecked (ויכול הכול)
        match /marks/{email} {
          allow read: if isStaff(schoolId)
                      || (isSignedIn()
                          && request.auth.token.email.lower() == email);
          allow create: if isStaff(schoolId)
                        || (isSignedIn()
                            && request.auth.token.email.lower() == email
                            && request.resource.data.keys()
                                 .hasOnly(['homeChecked']));
          allow update: if isStaff(schoolId)
                        || (isSignedIn()
                            && request.auth.token.email.lower() == email
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['homeChecked']));
          allow delete: if isStaff(schoolId);
        }
      }

      // רשימות שיבוץ/כיבוד (מודול 3.5) — הצוות יוצר; הורים נרשמים
      match /signups/{signupId} {
        allow read: if isCommunity(schoolId);
        allow create, delete: if isStaff(schoolId);
        // הורה מעדכן רק את מונה המשבצות — בטרנזקציה יחד עם ה-entry שלו
        allow update: if isStaff(schoolId)
                      || (isCommunity(schoolId)
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['counts']));

        match /entries/{email} {
          // שקיפות: כולם רואים מי הביא מה
          allow read: if isCommunity(schoolId);
          allow write: if isStaff(schoolId)
                       || (isSignedIn()
                           && request.auth.token.email.lower() == email);
        }
      }

      // פניות לצוות (מודול 3.6) — הפונה יוצר; הנמען קורא ומסמן טופל
      match /inquiries/{inquiryId} {
        allow create: if isCommunity(schoolId)
                      && request.resource.data.fromEmail
                           == request.auth.token.email.lower()
                      && request.resource.data.notified == false;
        allow read: if isSignedIn()
                    && (resource.data.toEmail == request.auth.token.email.lower()
                        || resource.data.fromEmail == request.auth.token.email.lower()
                        || memberRole(schoolId) == 'admin');
        allow update, delete: if isSignedIn()
                              && resource.data.toEmail
                                   == request.auth.token.email.lower();
      }

      // הערה: כשנוסיף מידע-צוות לאירועים, הוא יישב במסמך משנה נפרד
      // כי אין אבטחה ברמת שדה — לא להוסיף staffInfo למסמך הזה.
      match /events/{eventId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
