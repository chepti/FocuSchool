# ────────────────────────────────────────────────────────────────
#  פוקוסקול — משתני סביבה לבית ספר עצמאי
#  העתיקו את הקובץ ל-.env.local לפיתוח מקומי, והגדירו את אותם
#  המשתנים ב-Vercel → Project Settings → Environment Variables לפרודקשן.
#  כל ה-NEXT_PUBLIC_* ציבוריים (לא סודות) — האבטחה נאכפת ב-Firestore Rules.
# ────────────────────────────────────────────────────────────────

# ── Firebase (Project settings → Your apps → SDK setup and configuration) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── בית הספר (שם + עיר לתצוגת PWA/SEO; התוכן עצמו נשלף מ-Firestore) ──
# SCHOOL_ID = מזהה המסמך schools/{id}. קצר, באנגלית, אות ראשונה קטנה.
NEXT_PUBLIC_SCHOOL_ID=demo
NEXT_PUBLIC_SCHOOL_NAME=בית ספר שלי
NEXT_PUBLIC_SCHOOL_CITY=העיר שלי
NEXT_PUBLIC_SCHOOL_DESCRIPTION=
# כתובת הפרודקשן המלאה (ל-metadataBase ולקישור בנוטיפיקציות)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── נוטיפיקציות Push (חינם ב-Spark) ──
# מפתח ציבורי: Cloud Messaging → Web configuration → Web Push certificates
NEXT_PUBLIC_FCM_VAPID_KEY=
# ⚠️ סוד! service account JSON (Project settings → Service accounts →
#    Generate new private key) כשורה אחת. להגדיר רק ב-Vercel env — לעולם לא ב-git.
FIREBASE_SERVICE_ACCOUNT=

# ── זריעת נתונים ראשונית (רק בהרצת `npm run seed`, לא בפרודקשן) ──
SEED_ADMIN_EMAIL=you@gmail.com
SEED_ADMIN_NAME=מנהל/ת האתר
